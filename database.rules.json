{
  "rules": {
    ".read": "auth != null",
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "pushToken": {
          ".read": "auth != null"
        }
      }
    },
    "projects": {
      ".read": "auth != null",
      "$projectId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "projectEntries": {
      ".read": "auth != null",
      "$projectId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "invites": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
