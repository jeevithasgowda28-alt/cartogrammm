rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Users collection
    // - Anyone (even unauthenticated users registering) can read user profiles to check email/username uniqueness.
    // - Users can only write/update their own profile document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Chats (Direct Message Rooms)
    // - Only participants of the chat room can read or write room metadata.
    // - Read rules use resource.data.participants to allow Firestore collection queries that filter by participants.
    match /chats/{chatRoomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow write: if request.auth != null && (
        (resource != null && request.auth.uid in resource.data.participants) ||
        (request.resource != null && request.auth.uid in request.resource.data.participants)
      );
      
      // Messages within direct chats
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in chatRoomId.split('_');
      }
    }

    // 3. Groups (Group Chats)
    // - Any authenticated user can read or create group channels.
    // - Only current group members or the group admin can update or delete group metadata.
    match /groups/{groupId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.adminId ||
        request.auth.uid in resource.data.get('members', []) ||
        request.auth.uid in request.resource.data.get('members', [])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.adminId;
      
      // Messages within groups
      // - Users can read and write group messages if they are currently members of the group.
      match /messages/{messageId} {
        allow read, write: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.get('members', []);
      }
    }
  }
}
