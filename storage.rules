rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Chats storage folder
    // - Only participants of the chat (parsed from the "uid1_uid2" folder name) can upload or access files.
    match /chats/{chatRoomId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid in chatRoomId.split('_');
    }
  }
}
